#include <ESP32Servo.h>

#define NUM_SERVOS 6

Servo servos[NUM_SERVOS];

// Chân điều khiển 6 servo
int servoPins[NUM_SERVOS] = {23, 22, 21, 19, 5, 17};

// Góc hiện tại của từng servo
int currentAngles[NUM_SERVOS] = {
  90,   // servo 1 - đế
  110,  // servo 2 - vai
  80,   // servo 3 - khuỷu
  90,   // servo 4 - xoay cổ tay
  90,   // servo 5 - gập cổ tay
  80    // servo 6 - gripper mở
};

// Giới hạn an toàn cho từng servo
int minAngles[NUM_SERVOS] = {0, 0, 0, 0, 0, 0};
int maxAngles[NUM_SERVOS] = {180, 180, 180, 180, 180, 80};

// Tốc độ di chuyển tay
int armStepDelay = 15;     // ms, càng lớn càng chậm
int armStepSize = 1;       // mỗi bước tăng/giảm 1 độ

// Tốc độ đóng/mở gripper
int gripperStepDelay = 25; // ms
int gripperStepSize = 1;

// Góc gripper
int GRIPPER_CLOSE = 0;
int GRIPPER_OPEN = 80;
int GRIPPER_PRE_CLOSE = 15;


// =====================================================
// GẮN SERVO
// =====================================================

void attachServos() {
  for (int i = 0; i < NUM_SERVOS; i++) {
    servos[i].attach(servoPins[i]);
    delay(100);
  }
}


// =====================================================
// VỀ HOME
// =====================================================

void goHome() {
  int homeAngles[NUM_SERVOS] = {90, 110, 80, 90, 90, 80};

  for (int i = 0; i < NUM_SERVOS; i++) {
    currentAngles[i] = homeAngles[i];
    servos[i].write(currentAngles[i]);
    delay(200);
  }

  Serial.println("OK HOME");
}


// =====================================================
// IN GÓC HIỆN TẠI
// =====================================================

void printCurrentAngles() {
  Serial.print("CURRENT ");
  for (int i = 0; i < NUM_SERVOS; i++) {
    Serial.print(currentAngles[i]);
    if (i < NUM_SERVOS - 1) Serial.print(" ");
  }
  Serial.println();
}


// =====================================================
// DI CHUYỂN SERVO 1 -> 5 MƯỢT
// =====================================================

void moveArmSmooth(int targetAngles[]) {
  // Chỉ di chuyển servo 1 đến servo 5
  for (int i = 0; i < 5; i++) {
    targetAngles[i] = constrain(targetAngles[i], minAngles[i], maxAngles[i]);
  }

  bool moving = true;

  while (moving) {
    moving = false;

    for (int i = 0; i < 5; i++) {
      if (currentAngles[i] < targetAngles[i]) {
        currentAngles[i] += armStepSize;

        if (currentAngles[i] > targetAngles[i]) {
          currentAngles[i] = targetAngles[i];
        }

        servos[i].write(currentAngles[i]);
        moving = true;
      }

      else if (currentAngles[i] > targetAngles[i]) {
        currentAngles[i] -= armStepSize;

        if (currentAngles[i] < targetAngles[i]) {
          currentAngles[i] = targetAngles[i];
        }

        servos[i].write(currentAngles[i]);
        moving = true;
      }
    }

    delay(armStepDelay);
  }
}


// =====================================================
// DI CHUYỂN GRIPPER MƯỢT
// =====================================================

void moveGripperSmooth(int targetAngle) {
  targetAngle = constrain(targetAngle, 0, 80);

  while (currentAngles[5] != targetAngle) {
    if (currentAngles[5] < targetAngle) {
      currentAngles[5] += gripperStepSize;

      if (currentAngles[5] > targetAngle) {
        currentAngles[5] = targetAngle;
      }
    }

    else if (currentAngles[5] > targetAngle) {
      currentAngles[5] -= gripperStepSize;

      if (currentAngles[5] < targetAngle) {
        currentAngles[5] = targetAngle;
      }
    }

    servos[5].write(currentAngles[5]);
    delay(gripperStepDelay);
  }
}


// =====================================================
// LỆNH MOVE: CHỈ DI CHUYỂN, KHÔNG TỰ KẸP/MỞ
// =====================================================

void doMove(int targetAngles[]) {
  // Di chuyển tay trước
  moveArmSmooth(targetAngles);

  // Sau đó chỉnh gripper theo góc gửi vào
  moveGripperSmooth(targetAngles[5]);

  Serial.print("OK MOVE ");
  for (int i = 0; i < NUM_SERVOS; i++) {
    Serial.print(currentAngles[i]);
    if (i < NUM_SERVOS - 1) Serial.print(" ");
  }
  Serial.println();
}


// =====================================================
// LỆNH PICK
// =====================================================

void doPick(int targetAngles[]) {
  // 1. Mở gripper trước khi tới vật
  moveGripperSmooth(GRIPPER_OPEN);

  // 2. Di chuyển servo 1 -> 5 tới vị trí pick
  moveArmSmooth(targetAngles);

  delay(300);

  // 3. Kẹp từ từ: 80 -> 15 -> 0
  moveGripperSmooth(GRIPPER_PRE_CLOSE);

  delay(200);

  moveGripperSmooth(GRIPPER_CLOSE);

  Serial.print("OK PICK ");
  for (int i = 0; i < NUM_SERVOS; i++) {
    Serial.print(currentAngles[i]);
    if (i < NUM_SERVOS - 1) Serial.print(" ");
  }
  Serial.println();
}


// =====================================================
// LỆNH PLACE
// =====================================================

void doPlace(int targetAngles[]) {
  // 1. Giữ gripper đang kẹp
  moveGripperSmooth(GRIPPER_CLOSE);

  // 2. Di chuyển tới vị trí place
  moveArmSmooth(targetAngles);

  delay(300);

  // 3. Mở gripper từ từ để thả vật
  moveGripperSmooth(GRIPPER_OPEN);

  Serial.print("OK PLACE ");
  for (int i = 0; i < NUM_SERVOS; i++) {
    Serial.print(currentAngles[i]);
    if (i < NUM_SERVOS - 1) Serial.print(" ");
  }
  Serial.println();
}


// =====================================================
// ĐỌC LỆNH SERIAL
// =====================================================

void parseCommand(String input) {
  input.trim();

  if (input.length() == 0) {
    return;
  }

  if (input == "home") {
    goHome();
    return;
  }

  if (input == "print") {
    printCurrentAngles();
    return;
  }

  int targetAngles[NUM_SERVOS];

  // ---------------- MOVE ----------------
  int valuesReadMove = sscanf(
    input.c_str(),
    "move %d %d %d %d %d %d",
    &targetAngles[0],
    &targetAngles[1],
    &targetAngles[2],
    &targetAngles[3],
    &targetAngles[4],
    &targetAngles[5]
  );

  if (valuesReadMove == 6) {
    doMove(targetAngles);
    return;
  }

  // ---------------- PICK ----------------
  int valuesReadPick = sscanf(
    input.c_str(),
    "pick %d %d %d %d %d %d",
    &targetAngles[0],
    &targetAngles[1],
    &targetAngles[2],
    &targetAngles[3],
    &targetAngles[4],
    &targetAngles[5]
  );

  if (valuesReadPick == 6) {
    doPick(targetAngles);
    return;
  }

  // ---------------- PLACE ----------------
  int valuesReadPlace = sscanf(
    input.c_str(),
    "place %d %d %d %d %d %d",
    &targetAngles[0],
    &targetAngles[1],
    &targetAngles[2],
    &targetAngles[3],
    &targetAngles[4],
    &targetAngles[5]
  );

  if (valuesReadPlace == 6) {
    doPlace(targetAngles);
    return;
  }

  Serial.println("ERR UNKNOWN COMMAND");
}


// =====================================================
// SETUP
// =====================================================

void setup() {
  Serial.begin(115200);

  attachServos();

  delay(1000);

  goHome();

  Serial.println("ESP32 READY");
  Serial.println("Commands:");
  Serial.println("move s1 s2 s3 s4 s5 s6");
  Serial.println("pick s1 s2 s3 s4 s5 s6");
  Serial.println("place s1 s2 s3 s4 s5 s6");
  Serial.println("home");
  Serial.println("print");
}


// =====================================================
// LOOP
// =====================================================

void loop() {
  if (Serial.available()) {
    String input = Serial.readStringUntil('\n');
    parseCommand(input);
  }
}
