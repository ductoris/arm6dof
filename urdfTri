<?xml version="1.0" encoding="utf-8"?>
<robot name="articulated_gripper_robot">

  <!-- ================= MATERIALS ================= -->
  <material name="dark_gray">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.4 0.8 1.0"/>
  </material>

  <material name="orange">
    <color rgba="0.9 0.5 0.1 1.0"/>
  </material>

  <material name="light_gray">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>


  <!-- ================= BASE ================= -->
  <!-- base = 0.055 m -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0275" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.055" radius="0.06"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
  </link>


  <!-- ================= JOINT 1 ================= -->
  <!-- Joint 1 đặt trên đỉnh base -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.055" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-3.1416" upper="3.1416" velocity="1.0"/>
  </joint>


  <!-- ================= LINK 1 ================= -->
  <!-- link1 = 0.039 m -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.0195" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.039" radius="0.035"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>


  <!-- ================= JOINT 2 ================= -->
  <!-- Joint 2 đặt tại đầu link1 -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.039" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="15.0" lower="-1.5708" upper="1.5708" velocity="1.0"/>
  </joint>


  <!-- ================= LINK 2 ================= -->
  <!-- link2 = 0.14 m -->
  <link name="link2">
    <visual>
      <origin xyz="0.07 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.03 0.04 0.14"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>


  <!-- ================= JOINT 3 ================= -->
  <!-- Joint 3 đặt tại cuối link2 -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.14 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="15.0" lower="-2.0944" upper="2.0944" velocity="1.0"/>
  </joint>


  <!-- ================= LINK 3 ================= -->
  <!-- link3 = 0.103 m -->
  <link name="link3">
    <visual>
      <origin xyz="0.0515 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.103" radius="0.018"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>


  <!-- ================= JOINT 4 ================= -->
  <!-- Joint 4 đặt tại cuối link3 -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.103 0 0" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="5.0" lower="-3.1416" upper="3.1416" velocity="1.5"/>
  </joint>


  <!-- ================= LINK 4 / WRIST ================= -->
  <!-- Một phần của link3_2_EF -->
  <!-- Chọn đoạn wrist dài 0.04 m -->
  <link name="link4">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.03 0.03 0.04"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
  </link>


  <!-- ================= JOINT 5 ================= -->
  <!-- Joint 5 đặt sau wrist 0.04 m -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="gripper_base"/>
    <origin xyz="0.04 0 0" rpy="0 -1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5.0" lower="-1.5708" upper="1.5708" velocity="1.5"/>
  </joint>


  <!-- ================= GRIPPER BASE ================= -->
  <!-- Phần còn lại từ joint5 tới vùng gắp: 0.05 m -->
  <!-- Tổng joint4 tới EF xấp xỉ: 0.04 + 0.05 = 0.09 m -->
  <link name="gripper_base">
    <visual>
      <origin xyz="0.025 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.02 0.06 0.05"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
  </link>


  <!-- ================= LEFT FINGER ================= -->
  <joint name="gripper_finger_left" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger_left"/>
    <origin xyz="0.05 0.02 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit effort="5.0" lower="0.0" upper="0.02" velocity="0.1"/>
  </joint>

  <link name="finger_left">
    <visual>
      <origin xyz="0.015 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.008 0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>


  <!-- ================= RIGHT FINGER ================= -->
  <joint name="gripper_finger_right" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger_right"/>
    <origin xyz="0.05 -0.02 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5.0" lower="0.0" upper="0.02" velocity="0.1"/>
  </joint>

  <link name="finger_right">
    <visual>
      <origin xyz="0.015 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.008 0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

</robot>
